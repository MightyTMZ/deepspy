{
  "name": "periscope",
  "version": "0.1.0",
  "private": true,
  "description": "Periscope: super parsers for your competitors",
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=20.0.0 <21.0.0"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" build",
    "typecheck": "pnpm -r --filter \"./packages/**\" typecheck",
    "test": "pnpm -r --filter \"./packages/**\" test",
    "migrate": "pnpm --filter @periscope/knowledge migrate",
    "qdrant:dev": "bash scripts/dev-qdrant.sh"
  },
  "devDependencies": {
    "@types/node": "^20.19.9",
    "typescript": "^5.9.2",
    "vitest": "^2.1.9"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "onnxruntime-node",
      "protobufjs",
      "sharp"
    ]
  }
}
